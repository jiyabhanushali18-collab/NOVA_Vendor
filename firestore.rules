rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsVendor(id) {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/owner/$(request.auth.uid))
          && get(/databases/$(database)/documents/owner/$(request.auth.uid)).data.vendorId == id
        )
        || (
          exists(/databases/$(database)/documents/vendors/$(id))
          && get(/databases/$(database)/documents/vendors/$(id)).data.uid == request.auth.uid
        )
      );
    }

    function currentVendorId() {
      return signedIn()
        && exists(/databases/$(database)/documents/owner/$(request.auth.uid))
        ? get(/databases/$(database)/documents/owner/$(request.auth.uid)).data.vendorId
        : null;
    }

    function orderBelongsToVendor(data) {
      return signedIn() && (
        ('vendorId' in data && ownsVendor(data.vendorId))
        || (
          'vendorIds' in data
          && data.vendorIds is list
          && currentVendorId() is string
          && data.vendorIds.hasAny([currentVendorId()])
        )
      );
    }

    match /owner/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && (
          !('vendorId' in request.resource.data)
          || request.resource.data.vendorId is string
          && request.resource.data.vendorId.matches('VEN[0-9]{3}')
          && (
            !exists(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId))
            || getAfter(/databases/$(database)/documents/vendors/$(request.resource.data.vendorId)).data.uid == uid
          )
        );
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.uid == uid
        && (
          !('notificationPreferences' in request.resource.data)
          || request.resource.data.notificationPreferences is map
          && request.resource.data.notificationPreferences.keys().hasOnly(['orderAlerts', 'stockWarnings'])
          && (!('orderAlerts' in request.resource.data.notificationPreferences)
            || request.resource.data.notificationPreferences.orderAlerts is bool)
          && (!('stockWarnings' in request.resource.data.notificationPreferences)
            || request.resource.data.notificationPreferences.stockWarnings is bool)
        );
      allow delete: if false;
    }

    match /vendors/{vendorId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/owner/$(request.auth.uid)).data.vendorId == vendorId;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/owner/$(request.auth.uid)).data.vendorId == vendorId;
      allow delete: if false;
    }

    match /metadata/vendors {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.lastVendorNumber == 6
        && request.resource.data.keys().hasOnly(['lastVendorNumber', 'updatedAt']);
      allow update: if signedIn()
        && request.resource.data.lastVendorNumber == resource.data.lastVendorNumber + 1
        && request.resource.data.keys().hasOnly(['lastVendorNumber', 'updatedAt']);
      allow delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if signedIn() && ownsVendor(request.resource.data.vendorId);
      allow update: if signedIn()
        && ownsVendor(resource.data.vendorId)
        && request.resource.data.vendorId == resource.data.vendorId;
      allow delete: if signedIn() && ownsVendor(resource.data.vendorId);
    }

    match /orders/{orderId} {
      allow get: if orderBelongsToVendor(resource.data)
        || (signedIn() && exists(/databases/$(database)/documents/customerOrders/$(request.auth.uid)/orders/$(orderId)));
      allow list: if orderBelongsToVendor(resource.data);
      allow create: if signedIn()
        && request.resource.data.vendorId == currentVendorId()
        && request.resource.data.keys().hasOnly([
          'id', 'customerName', 'customerInitials', 'customerAvatar', 'productName',
          'quantity', 'amount', 'date', 'status', 'vendorId', 'vendorName',
          'createdAt', 'updatedAt'
        ]);
      allow update: if false;
      allow delete: if orderBelongsToVendor(resource.data)
        && (!('salesEligible' in resource.data) || resource.data.salesEligible != true)
        && (!('vendorIds' in resource.data) || resource.data.vendorIds.size() == 1);
    }

    match /vendorOrders/{vendorId}/orders/{orderId} {
      allow read: if ownsVendor(vendorId);
      allow write: if false;
    }

    match /customerOrders/{customerId}/orders/{orderId} {
      allow read: if signedIn() && request.auth.uid == customerId;
      allow write: if false;
    }

    match /vendorSales/{vendorId}/products/{productId} {
      allow read: if ownsVendor(vendorId);
      allow write: if false;
    }

    match /vendorSales/{vendorId}/dailyProducts/{dailyProductId} {
      allow read: if ownsVendor(vendorId);
      allow write: if false;
    }

    match /analytics_events/{eventId} {
      allow read: if ownsVendor(resource.data.vendorId);
      allow create: if signedIn();
      allow update, delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'productId', 'productName', 'vendorId', 'arTryOn', 'arRating', 'rating',
          'comment', 'feedback', 'review', 'author', 'customerName',
          'userName', 'userId', 'uid', 'color', 'variantColor',
          'createdAt', 'timestamp'
        ])
        && request.resource.data.productId is string
        && request.resource.data.vendorId is string
        && request.resource.data.arTryOn == true
        && (
          ('arRating' in request.resource.data
            && request.resource.data.arRating is number
            && request.resource.data.arRating >= 1
            && request.resource.data.arRating <= 5)
          || (!('arRating' in request.resource.data)
            && 'rating' in request.resource.data
            && request.resource.data.rating is number
            && request.resource.data.rating >= 1
            && request.resource.data.rating <= 5)
        )
        && (!('comment' in request.resource.data) || request.resource.data.comment is string && request.resource.data.comment.size() <= 1000)
        && (!('feedback' in request.resource.data) || request.resource.data.feedback is string && request.resource.data.feedback.size() <= 1000)
        && (!('review' in request.resource.data) || request.resource.data.review is string && request.resource.data.review.size() <= 1000)
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && request.resource.data.createdAt == request.time
        && (!('productName' in request.resource.data) || request.resource.data.productName is string)
        && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.vendorId == request.resource.data.vendorId;
      allow update, delete: if false;
    }

    match /product_reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.productId is string
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.accountUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
      allow update, delete: if signedIn()
        && resource.data.accountUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
